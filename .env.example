# Google AI key for every Gemini call.
GEMINI_API_KEY=

# Reads spines and finds items in each saved frame.
READER_MODEL=gemini-4-argon

# Merges sightings, identifies, prices and scores.
JUDGE_MODEL=gemini-4-argon

# Judges each captured frame fast during the sweep.
FRAME_MODEL=gemini-3.8-flash

# Points at the room's corners, edges, openings and shelving.
GEOMETRY_MODEL=gemini-4-argon

# Searches the web for new and used prices.
PRICE_MODEL=gemini-4-argon

# Thinking level for grounded search calls; empty keeps the model's default.
SEARCH_THINKING=

# Checks each price against its page.
CHECK_MODEL=gemini-3.8-flash

# Talks with the policyholder during the sweep.
LIVE_MODEL=gemini-3.8-live

# Live context size at which the oldest turns are compressed.
LIVE_COMPRESS_TOKENS=25600

# Prebuilt voice of the live agent.
LIVE_VOICE=Kore

# Tries per model call on 408, 429 and 5xx.
MODEL_ATTEMPTS=5

# Milliseconds one model request may take.
MODEL_TIMEOUT_MS=600000

# USD a process may spend on model calls at list prices; past it no request is sent.
BUDGET_USD=5

# Model calls in flight at once in the background pipeline.
CONCURRENCY=96

# Paid-tier list prices from ai.google.dev/gemini-api/docs/pricing, checked 2026-10-24.
PRICES={"gemini-4-argon": {"input": 2.0, "output": 10.0, "cached": 0.1}, "gemini-3.8-flash": {"input": 0.75, "output": 3.75, "cached": 0.075}, "gemini-robotics-er-2-preview": {"input": 0.75, "output": 3.75, "cached": 0.075}}

# USD per grounded search request past the free monthly quota.
SEARCH_USD=0.014

# Live model USD per 1M tokens by modality (pricing page, 2026-10-24); video frames bill as IMAGE.
LIVE_PRICES={"TEXT": {"input": 0.75, "output": 4.5, "cached": 0}, "AUDIO": {"input": 3.0, "output": 12.0, "cached": 0}, "IMAGE": {"input": 1.0, "output": 0.0, "cached": 0}}

# The claim's market.
LOCALE={"country":"India","currency":"INR","appraisal_limit":100000.0}

# The market the sample of books is priced in again, to show locale is a setting.
SECOND_LOCALE={"country":"United Kingdom","currency":"GBP","appraisal_limit":1000.0}

# Identified lines below this confidence also go to review.
REVIEW_CONFIDENCE=0.8

# Books priced again in the second market.
SECOND_SAMPLE=10

# Short and long side of the reference sheet.
REFERENCE_MM=[210, 297]

# Spine crops of one book sent to identification, clearest first.
IDENTIFY_CROPS=4

# Frames already placed that the tracker sees again with each batch.
CONTEXT_FRAMES=2

# Share of a box's size added on each side when cropping it.
CROP_PAD=0.15

# Seconds after the sweep ends when a packet is written from the work done; the final one follows.
PACKET_DUE_S=280

# Seconds between full-resolution frames the phone uploads.
FRAME_SECONDS=1.0

# Long side of the frames the live model sees.
LIVE_FRAME_PX=1024

# Reconnects in a row the bridge tries after a live session fails.
LIVE_RETRIES=5

# Seconds before reconnecting a failed live session.
LIVE_RETRY_S=2

# Seconds a packet read-back waits for a live session to reopen.
LIVE_WAIT_S=30

# Level of the app's own log lines on the server.
LOG_LEVEL=INFO

# One folder per sweep: frames, events and the packet.
RUNS_DIR=runs

# Seconds a source page fetch may take.
FETCH_SECONDS=20

# User agent for fetching source pages, as the policyholder's phone browser would send.
USER_AGENT=Mozilla/5.0 (Linux; Android 10) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/141.0 Mobile Safari/537.36

# Accept header for source pages.
ACCEPT=text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8

# Accept-Language header for source pages.
ACCEPT_LANGUAGE=en-IN,en;q=0.9

# ECB reference rates (Frankfurter).
FX_URL=https://api.frankfurter.dev/v1

# None
SCORING={"count_tolerance":0.05,"identified_bar":0.7,"wrong_bar":0.03,"spine_tolerance":0.15,"price_tolerance":0.25,"items_bar":0.8,"floor_tolerance":0.1,"wall_tolerance":0.15,"opening_min_m2":0.0,"packet_seconds":300.0,"confidence":0.95}
